# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/.pnp
.pnp.js
node_modules

# testing
/coverage

# production
/build
/dist

# environment variables
.env
.env.local
# Google service-account private key — committing it hands anyone with repo
# access write control of the spreadsheet.
service-account.json
**/service-account.json
.env.development.local
.env.test.local
.env.production.local

# editor metadata
.history/
.lh/
.vs/
.vscode/settings.json

# misc
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local SQLite action log
src/Backend/actions.db
src/Backend/actions.db-*

# Test-run output. These are produced by the app (Export / Extent Report) and
# regenerate on every run, so committing them only ever yields merge noise.
src/assets/testexpress-report-*.html
src/assets/testexpress-report-*.json
src/assets/testexpress-reports.csv
src/assets/Screenshot *.png

# Stray empty file from a shell redirect, not a credential.
/password

# Playwright run output: traces, failure screenshots and the HTML report, all
# regenerated by the next run. `tests/` is deliberately NOT here — the specs are
# the reviewable artefact scripts/review-tests.js puts on a branch.
/test-results
/playwright-report
/blob-report
/playwright/.cache
