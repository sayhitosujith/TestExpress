# Copy this file to .env and fill in the real values.
# The real .env is gitignored — never commit it.

# MongoDB (existing)
MONGO_URI=mongodb+srv://username:password@cluster0.xxxx.mongodb.net/hospital

# Server
PORT=5000

# ---- Email (Resend) ----
# When set, contact-form notifications, replies and admin-issued access-key
# emails are sent through Resend's HTTPS API. Without them, submissions still
# save to the database; only the email is skipped (see
# src/Backend/emailNotify.js). Not Gmail SMTP any more -- Render's outbound
# network blocks every SMTP port regardless of target or IP version (tried
# 465 and 587, both IPv4 and IPv6), so an HTTPS-based provider is the fix.
#
# Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
# The address mail is sent from. onboarding@resend.dev (the default) is
# Resend's shared, unverified address -- it can only deliver to the email on
# your own Resend account, which is fine for confirming sending works but not
# for real visitors. Verify your own domain with Resend, then set this to an
# address on it (e.g. noreply@yourdomain.com) to send to anyone.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where the internal "new submission" notification lands. Required -- unlike
# the old Gmail setup there is no sending account to fall back to.
CONTACT_NOTIFY_EMAIL=wetestexpress@gmail.com
# The frontend's origin (no path) -- the access-key email links to
# <APP_URL>/verify-access-key. Defaults to the deployed Netlify frontend, so
# this only needs setting for a different deployment.
APP_URL=https://testexpress-qa.netlify.app

# Twilio Verify — from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# A Twilio phone number (E.164, e.g. +1XXXXXXXXXX) used to send appointment
# confirmation SMS. Get one free on trial: Console -> Phone Numbers -> Buy a number.
TWILIO_PHONE_NUMBER=

# ---- Appointment notification channel ----
# "sms" (default) | "whatsapp" | "both". WhatsApp is sent via Twilio.
NOTIFY_CHANNEL=sms
# WhatsApp sender. On Twilio trial use the Sandbox number (whatsapp:+14155238886)
# and join it from your phone first by sending the join code on WhatsApp.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Appointment-confirmation SMS provider ----
# "msg91" (best for India delivery) or "twilio".
# Auto-selects msg91 when MSG91_AUTHKEY is present.
SMS_PROVIDER=msg91
# MSG91 (https://msg91.com). Needs a DLT-approved template whose variable
# placeholders are named date / time / name to match this app's payload.
MSG91_AUTHKEY=
# DLT template for a new booking (scheduling).
MSG91_TEMPLATE_ID=
# Optional: separate DLT template for reschedule SMS (falls back to MSG91_TEMPLATE_ID).
MSG91_TEMPLATE_ID_RESCHEDULED=
# Optional: separate DLT template for cancellation SMS (falls back to MSG91_TEMPLATE_ID).
MSG91_TEMPLATE_ID_CANCELLED=
MSG91_SENDER_ID=

# Country code prepended to bare 10-digit mobile numbers (E.164)
# e.g. +91 (India), +61 (Australia)
OTP_DEFAULT_COUNTRY_CODE=+91

# --- Session tokens (sign-in) ---
# Signs the session token /api/auth/login issues and /api/admin requires. Any
# long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the backend still authenticates people, but signs tokens with a key
# invented at startup: every session is dropped by a restart, and two instances
# behind a load balancer will reject each other's tokens.
AUTH_SECRET=

# --- Online database (registrations) ---
# Any Postgres connection string: Neon, Supabase, Render, Railway or self-hosted.
# The registrations table is created automatically on first use. Without this the
# /api/registrations routes answer 501 with setup steps and the app stays local.
DATABASE_URL=
# Only for a self-hosted server with a self-signed certificate. Leave unset for
# hosted providers -- it disables TLS certificate verification.
DATABASE_SSL_NO_VERIFY=

# --- User story -> test cases -> Qase (src/QaseImport.jsx) ---
# Claude generates the cases. Without this the /api/qase/generate route answers
# 501 with setup steps and the rest of the API is unaffected.
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Qase API token — a full-write credential for every project in the account,
# which is why it lives here and never in a REACT_APP_* variable: those are
# compiled into the browser bundle. Qase -> avatar -> API tokens.
# Without this, generation, CSV export and local filing still work; only the
# push to Qase answers 501.
QASE_API_TOKEN=

# Razorpay — the payment step on /Checkout.
#
# With both set, pressing Pay opens Razorpay's own hosted checkout, which is
# where UPI, the QR code, cards and netbanking live; the card details never
# reach this app. Without them the step falls back to a clearly-labelled
# simulation that takes no money and asks for no card details, so the
# registration flow still works on an install with no Razorpay account.
#
# Get them from the Razorpay dashboard under Settings > API Keys. Test keys
# start rzp_test_ and move no real money — use those first.
#
# The secret is what signs a payment and what verifies it here. It must never
# be given to the browser, which is why only the key id is sent to the page.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The webhook secret, which is NOT the API key secret — it is set separately in
# the dashboard under Settings > Webhooks, where you also give it the URL:
#
#   https://<your public host>/api/checkout/webhook
#   events: payment.captured, order.paid
#
# Strongly recommended before taking live payments. Without it the only proof a
# payment settled is the browser's success callback, which never fires if the
# payer closes the tab or their bank redirects them elsewhere — they are charged
# and left unable to sign in. With it, the account is enabled either way.
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in (SSO) on the login page.
#
# With this set, the sign-in page shows Google's own button; without it, the
# button is not drawn at all and the password form is the whole of the page.
#
# The browser is given this id (it is public by design — it identifies the app
# to Google and is embedded in every button Google renders). What matters is
# what the backend does with the token that comes back: it verifies the
# signature against Google's published keys, and checks that the token was
# issued for THIS id. That second check is why the value belongs here and not
# only in the browser — a token minted for another application would otherwise
# be accepted.
#
# Get it from console.cloud.google.com > APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application. Add your origins to
# "Authorised JavaScript origins" — http://localhost:3000 for development.
#
# There is no client *secret* here: the ID-token flow does not use one.
#
# An address signing in for the first time gets an account on the first plan,
# with the role User and no password — it signs in through Google until an
# administrator sets one.
GOOGLE_CLIENT_ID=
