# Copy this file to .env and fill in the values.
# Never commit the real .env file — it is listed in .gitignore.

# Backend API base URL (Express OTP server). Defaults to http://localhost:5000 if unset.
REACT_APP_API_URL=http://localhost:5000

# Google Analytics 4 measurement id (analytics.google.com > Admin > Data
# Streams > your web stream). Leave empty to disable analytics (see
# src/analytics.js). Not a secret -- it is sent to the browser on every page
# load regardless of whether it lives in source control.
REACT_APP_GA_MEASUREMENT_ID=

# Google Sheets datastore (backend — put these in src/Backend/.env)
# The spreadsheet id is the long segment in its URL:
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
# Share the sheet with the service account's client_email as an Editor, or every
# call comes back 403 even though the credentials themselves are valid.
GOOGLE_SHEET_ID=1SFQGotjKjbj0iyrAXVaap4nRjpW7lpAMjlAbzbzx2SU
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# Alternative to the file, for hosts that only offer env vars: the same JSON on
# a single line.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Supabase
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_KEY=your_supabase_anon_key

# Firebase
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
