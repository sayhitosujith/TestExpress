{
  "name": "testexpress",
  "version": "25.6.2",
  "HomePage": "/",
  "private": true,
  "proxy": "http://localhost:5000",
  "dependencies": {
    "@docsearch/react": "^3.6.0",
    "@emailjs/browser": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "@material-tailwind/react": "^2.1.10",
    "@supabase/supabase-js": "^2.105.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "axios": "^1.15.2",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "fs": "^0.0.1-security",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "localforage": "^1.10.0",
    "match-sorter": "^6.3.1",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-datepicker": "^8.7.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.5.0",
    "react-otp-input": "^3.1.1",
    "react-phone-input-2": "^2.15.1",
    "react-resizable": "^3.0.5",
    "react-router-dom": "^6.20.1",
    "react-scripts": "^5.0.1",
    "react-slick": "^0.31.0",
    "react-world-flags": "^1.6.0",
    "reactjs-popup": "^2.0.6",
    "slick-carousel": "^1.8.1",
    "sort-by": "^1.2.0",
    "three": "^0.184.0",
    "use-react-countries": "^2.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 react-scripts start",
    "server": "npm --prefix src/Backend start",
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm start\" \"npm run server\"",
    "notify:test": "node src/Backend/scripts/notify-test.js",
    "tests:review": "node scripts/review-tests.js",
    "test:e2e": "playwright test --workers=100%",
    "test:e2e:serial": "playwright test --workers=1",
    "test:e2e:report": "playwright show-report",
    "build": "cross-env CI=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:mobile-tree": "node src/Backend/scripts/mobile-tree.test.js",
    "test:auth": "node src/Backend/scripts/auth.test.js",
    "test:sessions": "node src/Backend/scripts/sessions.test.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "src/testrunner/spec.js",
          "src/testrunner/mobileSpec.js",
          "src/testrunner/selfHeal.js",
          "src/testrunner/testdata.js"
        ],
        "rules": {
          "no-restricted-syntax": [
            "error",
            {
              "selector": "ObjectExpression > SpreadElement",
              "message": "Spread/rest is banned in this file. It is CommonJS (module.exports, and the Node-side backend requires it directly). Object spread here makes the production bundle throw \"ES Modules may not assign module.exports\" while it is still evaluating, which aborts the whole bundle and renders the entire app blank — see the note in src/testrunner/selfHeal.js. Use Object.assign / concat / slice instead."
            },
            {
              "selector": "ArrayExpression > SpreadElement",
              "message": "Spread/rest is banned in this file. It is CommonJS (module.exports, and the Node-side backend requires it directly). Object spread here makes the production bundle throw \"ES Modules may not assign module.exports\" while it is still evaluating, which aborts the whole bundle and renders the entire app blank — see the note in src/testrunner/selfHeal.js. Use Object.assign / concat / slice instead."
            },
            {
              "selector": "ObjectPattern > RestElement",
              "message": "Spread/rest is banned in this file. It is CommonJS (module.exports, and the Node-side backend requires it directly). Object spread here makes the production bundle throw \"ES Modules may not assign module.exports\" while it is still evaluating, which aborts the whole bundle and renders the entire app blank — see the note in src/testrunner/selfHeal.js. Use Object.assign / concat / slice instead."
            }
          ]
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^3.3.6"
  },
  "engines": {
    "node": "18.x",
    "npm": "10.x"
  }
}
