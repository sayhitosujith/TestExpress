# Peer dependencies are resolved the npm 6 way: declared, not enforced.
#
# Not a preference. npm 7+ refuses to install this tree at all otherwise —
# react-scripts@5 declares `peerOptional typescript@^3.2.1 || ^4` while
# i18next@26 wants `^5 || ^6 || ^7`, so the resolver hits ERESOLVE and stops.
# The conflict is over a package that is not in the tree and is not wanted in
# it: this is a JavaScript app, nothing here compiles TypeScript, and both
# declarations are peerOptional. There is nothing to reconcile, only a resolver
# to tell so.
#
# Committed rather than left to each machine because CI needs it too. Every
# pipeline src/testrunner/pipeline.js generates begins with `npm ci`, which
# fails on exactly this and takes the whole run down before a single test
# starts. A repo file fixes that for every provider at once and keeps
# `--legacy-peer-deps` out of the generated YAML, which is generic and should
# not carry one repo's quirk.
#
# The narrower fix would be an override pinning typescript, but pinning a
# package that is absent to satisfy two optional peers is a fiction that then
# has to be maintained. Revisit when react-scripts is replaced — Vite has no
# such peer, and this line can go with it.
legacy-peer-deps=true
